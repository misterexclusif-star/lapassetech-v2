---
/**
 * RessourceLayout — gabarit ressource v4.5 (format exécution).
 * Hero 2 colonnes (chips niveau/thème/durée + visuel polaroid), carte
 * « avant de commencer », corps (étapes en Markdown), carte « tu as terminé
 * quand », bloc liens officiels EN FIN DE PAGE uniquement (spec §6),
 * « pour continuer ».
 */
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import PdfModal from "../components/PdfModal.astro";

interface Props {
  id?: string;
  title: string;
  description?: string;
  level?: "deb" | "int" | "avance";
  theme?: string;
  duration?: string;
  visual?: string;
  prereqs?: string[];
  doneWhen?: string[];
  links?: { label: string; url: string; note?: string }[];
  pdfUrl?: string;
  subscribeType?: string;
}

const {
  id,
  title,
  description,
  level = "deb",
  theme,
  duration,
  visual,
  prereqs = [],
  doneWhen = [],
  links = [],
  pdfUrl,
  subscribeType = "newsletter",
} = Astro.props;

const levelLabels: Record<string, string> = {
  deb: "débutant",
  int: "intermédiaire",
  avance: "avancé",
};

const themeCat = (t?: string) => {
  const s = (t ?? "").toLowerCase();
  if (s.includes("financement")) return "cat-fin";
  if (s.includes("ia")) return "cat-reco";
  if (s.includes("no-code")) return "cat-perso";
  return "cat-met";
};

// « Pour continuer » : 2 autres ressources.
const nextRes = (await getCollection("ressources", ({ data }) => !data.draft))
  .filter((r) => r.id !== id)
  .slice(0, 2);
---

<BaseLayout title={`${title} — LaPasseTech`} description={description}>
  <div class="wrap">
    <nav class="crumb" aria-label="Fil d'ariane">
      <a href="/">accueil</a> → <a href="/ressources">ressources</a>
      {theme && <> → {theme.toLowerCase()}</>}
    </nav>
    <div class:list={["rs-head", visual && "rs-grid"]}>
      <div>
        <div class="rtags rv">
          <span class={`lvl ${level === "deb" ? "" : "inter"}`}>{levelLabels[level]}</span>
          {theme && <span class={`acat ${themeCat(theme)}`}>{theme.toLowerCase()}</span>}
          {duration && <span class="rtime">{duration}</span>}
        </div>
        <h1 class="rv d1">{title}</h1>
        {description && <p class="sub rv d2">{description}</p>}
        {
          pdfUrl && (
            <button class="btn-pdf rv d2" type="button" data-open-pdf-modal>
              ⬇ Télécharger la version PDF
            </button>
          )
        }
      </div>
      {
        visual && (
          <figure class="rs-visual rv d2" aria-hidden="true">
            <img src={visual} alt="" loading="eager" />
          </figure>
        )
      }
    </div>

    <div class="rs-layout">
      {
        prereqs.length > 0 && (
          <div class="prereq rv">
            <span class="mono">// avant de commencer, prépare</span>
            <ul>
              {prereqs.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
        )
      }

      <article class="prose">
        <slot />
      </article>

      {
        doneWhen.length > 0 && (
          <div class="done rv">
            <span class="mono">// tu as terminé quand</span>
            <ul>
              {doneWhen.map((d) => (
                <li>
                  <span class="tick">✓</span>
                  {d}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        links.length > 0 && (
          <div class="liens rv">
            <span class="mono">// les liens de cette ressource — à ouvrir maintenant que tu sais quoi y faire</span>
            {links.map((l) => (
              <a class="lien-row" href={l.url} target="_blank" rel="noopener">
                <div>
                  <b>{l.label}</b>
                  {l.note && <p>{l.note}</p>}
                </div>
                <span class="ext" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))}
          </div>
        )
      }

      {
        nextRes.length > 0 && (
          <>
            <div class="rel-head rv">
              <h2>Pour continuer</h2>
              <a href="/ressources">Toutes les ressources →</a>
            </div>
            <div class="agrid next-grid">
              {nextRes.map((r) => (
                <a href={`/ressources/${r.id}`} class="acard rv">
                  <span class={`acat ${themeCat(r.data.theme)}`}>{r.data.theme.toLowerCase()}</span>
                  <h2>{r.data.title}</h2>
                  <p>{r.data.description}</p>
                  <span class="ameta">ressource{r.data.duration && ` · ${r.data.duration}`}</span>
                  <span class="alire">Ouvrir la ressource</span>
                </a>
              ))}
            </div>
          </>
        )
      }
    </div>
  </div>

  <section class="page-cta">
    <div class="wrap">
      <h2>Pas sûr que ce soit ta priorité ? <em class="s">Vérifions.</em></h2>
      <a href="/bilan" class="btn btn-jaune">Faire mon bilan gratuit →</a>
      <span class="mono">// 5 minutes · sans email obligatoire</span>
    </div>
  </section>

  {pdfUrl && <PdfModal pdfUrl={pdfUrl} subscribeType={subscribeType} />}
</BaseLayout>

<style>
  .btn-pdf {
    display: inline-block;
    margin-top: 22px;
    padding: 13px 26px;
    background: var(--jaune);
    color: var(--noir);
    font-family: var(--body);
    font-weight: 700;
    font-size: 0.95rem;
    border: 2px solid var(--noir);
    border-radius: 999px;
    box-shadow: var(--shadow-pop-sm);
    cursor: pointer;
  }
  .btn-pdf:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--noir);
  }
  .rs-head {
    padding: 26px 0 30px;
    border-bottom: 2px solid var(--noir);
  }
  .rs-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }
  .rs-head h1 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 14px 0 14px;
  }
  .rtags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
    align-items: center;
  }
  .lvl {
    font-family: var(--mono);
    font-size: 0.64rem;
    font-weight: var(--fw-semi);
    padding: 4px 11px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--noir);
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    background: #fff;
  }
  .lvl::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--jaune);
    border: 1px solid var(--noir);
  }
  .lvl.inter::before {
    background: var(--caramel);
  }
  .rtime {
    font-family: var(--mono);
    font-size: 0.66rem;
    background: var(--jaune);
    border: 1.5px solid var(--noir);
    border-radius: var(--radius-pill);
    padding: 4px 11px;
  }
  .rs-visual {
    position: relative;
    transform: rotate(-2deg);
    max-width: 400px;
    justify-self: end;
    width: 100%;
    margin: 0;
  }
  .rs-visual img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border: 2px solid var(--noir);
    border-radius: 14px;
    box-shadow: var(--shadow-pop);
    background: #fff;
  }
  .rs-visual::before {
    content: "";
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%) rotate(2deg);
    width: 104px;
    height: 28px;
    background: var(--caramel-16);
    border: 1px dashed var(--caramel);
    border-radius: 3px;
    z-index: 2;
  }
  .rs-layout {
    max-width: 820px;
    padding: 10px 0 60px;
  }
  .prereq {
    background: #fff;
    border: 2px solid var(--noir);
    border-radius: 14px;
    padding: 22px 24px;
    box-shadow: var(--shadow-pop-sm);
    margin: 34px 0;
  }
  .prereq .mono {
    color: var(--caramel);
    display: block;
    margin-bottom: 12px;
  }
  .prereq ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .prereq li {
    position: relative;
    padding-left: 1.6em;
    font-size: 0.95rem;
  }
  .prereq li::before {
    content: "☐";
    font-weight: var(--fw-black);
    color: var(--caramel);
    position: absolute;
    left: 0;
  }
  .prose {
    font-size: 1.02rem;
    line-height: 1.75;
    min-width: 0;
  }
  .prose :global(h2) {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.45rem;
    margin: 40px 0 14px;
    scroll-margin-top: 110px;
    line-height: 1.15;
  }
  .prose :global(p) {
    margin: 0 0 18px;
    color: rgba(26, 23, 20, 0.85);
  }
  .prose :global(ul) {
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .prose :global(ul li) {
    position: relative;
    padding-left: 1.5em;
  }
  .prose :global(ul li)::before {
    content: "→";
    color: var(--caramel);
    font-weight: var(--fw-black);
    position: absolute;
    left: 0;
  }
  .prose :global(ol) {
    margin: 0 0 18px;
    padding-left: 1.4em;
    display: grid;
    gap: 10px;
  }
  .prose :global(blockquote) {
    background: var(--caramel-10);
    border: 2px dashed var(--caramel);
    border-radius: 12px;
    padding: 16px 20px;
    margin: 24px 0;
    font-size: 0.95rem;
  }
  .done {
    background: var(--beige);
    border: 2px solid var(--noir);
    border-radius: 14px;
    padding: 22px 24px;
    margin: 40px 0 0;
  }
  .done .mono {
    color: var(--caramel);
    display: block;
    margin-bottom: 12px;
  }
  .done ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .done li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 0.95rem;
  }
  .done .tick {
    flex: none;
    width: 22px;
    height: 22px;
    background: var(--jaune);
    border: 2px solid var(--noir);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-black);
    font-size: 0.75rem;
    transform: rotate(-4deg);
  }
  .rel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid var(--noir);
    padding-bottom: 12px;
    margin-top: 50px;
  }
  .rel-head h2 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .rel-head a {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--caramel);
    text-decoration: none;
  }
  .next-grid {
    grid-template-columns: 1fr 1fr;
    padding-top: 26px;
    padding-bottom: 0;
  }

  @media (max-width: 980px) {
    .rs-grid {
      grid-template-columns: 1fr;
    }
    .rs-visual {
      justify-self: start;
    }
  }
  @media (max-width: 640px) {
    .next-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
