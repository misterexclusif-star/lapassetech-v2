---
/**
 * BaseLayout — gabarit racine de toutes les pages.
 * Importe le design system UNE seule fois, puis assemble
 * Ticker + Header + <slot/> + Footer.
 * Props :
 *   title       : titre de l'onglet
 *   description : meta description SEO
 */
import "../styles/design-system/styles.css";
import Ticker from "../components/Ticker.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "LaPasseTech — Reconversion vers les métiers du digital",
  description = "Métiers du digital, formations financées à 100 %, parcours qui te ressemblent. Sans bullshit, sans jargon, sans complexe.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <Ticker />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // v4.5 — reveal au scroll des éléments .rv (neutralisé en reduced-motion par le CSS)
      const io = new IntersectionObserver(
        (es) => {
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll(".rv").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
