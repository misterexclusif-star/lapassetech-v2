---
/**
 * ArticleLayout — gabarit page article.
 * Hero (breadcrumb + tag + titre + meta) puis lecture 2 colonnes :
 * prose (<slot/>) + aside sticky (sommaire stub + carte bilan).
 */
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/Button.astro";

interface Props {
  title: string;
  description?: string;
  tag?: string;
  date?: Date;
  readingTime?: string;
}

const { title, description, tag, date, readingTime } = Astro.props;
const dateStr = date
  ? new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" }).format(date)
  : undefined;
---

<BaseLayout title={`${title} — LaPasseTech`} description={description}>
  <section class="lpt-page-hero">
    <nav class="lpt-breadcrumb"><a href="/">Accueil</a> → <a href="/articles">Articles</a> → <span>{title}</span></nav>
    {tag && <span class="lpt-tag" style="margin-top:14px; display:inline-block;">{tag}</span>}
    <h1 class="lpt-page-hero__title">{title}</h1>
    <div class="lpt-page-hero__meta">
      {readingTime && <span>{readingTime}</span>}
      {readingTime && dateStr && <span>·</span>}
      {dateStr && <span>{dateStr}</span>}
    </div>
  </section>

  <div class="lpt-reading">
    <article class="lpt-prose">
      <slot />
    </article>

    <aside class="lpt-aside">
      <div class="lpt-aside-card lpt-aside-card--brown">
        <h4>Pas encore sûr de ta direction ?</h4>
        <p style="font-size:13.5px; line-height:1.55;">Fais ton bilan PassBot en 10 minutes — gratuit, sans engagement.</p>
        <Button variant="cta" href="/bilan" label="Faire mon bilan" class="lpt-aside-cta" />
      </div>
      <div class="lpt-aside-card">
        <h4>Sur le même thème</h4>
        <nav class="lpt-toc">
          <a href="/articles">Tous les articles</a>
          <a href="/ressources">Les ressources pratiques</a>
          <a href="/metiers">Les fiches métiers</a>
        </nav>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .lpt-aside-cta {
    margin-top: 14px;
  }
</style>
