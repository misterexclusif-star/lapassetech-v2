---
/**
 * Header — navigation principale.
 * Marque + 5 onglets + indicateur de statut PassBot + CTA "Faire mon bilan".
 * Chrome (.lpt-header*) défini dans le design system (content.css).
 */
import Button from "./Button.astro";
import LogoMark from "./LogoMark.astro";

const nav = [
  { label: "Articles", href: "/articles" },
  { label: "Ressources", href: "/ressources" },
  { label: "Métiers", href: "/metiers" },
  { label: "Bilan", href: "/bilan" },
  { label: "À propos", href: "/a-propos" },
];

// Onglet actif d'après l'URL courante (préfixe).
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="lpt-header">
  <a class="lpt-header__brand" href="/"><LogoMark /></a>

  <nav aria-label="Navigation principale">
    <ul class="lpt-header__nav">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class={isActive(item.href) ? "is-active" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="lpt-header__actions">
    <span class="lpt-status" title="PassBot est disponible">
      <span class="lpt-status__dot"></span> PassBot · en ligne
    </span>
    <Button variant="cta" href="/bilan" label="Faire mon bilan" />
  </div>
</header>

<style>
  .lpt-header__actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  /* Onglet actif : couleur forte + soulignement caramel discret */
  .lpt-header__nav a.is-active {
    color: var(--text-strong);
    font-weight: var(--fw-semi);
  }
  @media (max-width: 980px) {
    /* .lpt-header__nav est masqué par le design system < 980px ;
       on garde statut + CTA visibles. */
    .lpt-status {
      display: none;
    }
  }
</style>
