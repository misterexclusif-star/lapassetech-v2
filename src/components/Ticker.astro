---
/**
 * Ticker — bandeau défilant sous le Header.
 * Fond caramel profond, texte crème en majuscules, marquee CSS pur (boucle).
 * Respecte prefers-reduced-motion (animation désactivée → bandeau statique).
 */
const items = [
  "POEI",
  "CDI garanti avant la formation",
  "CPF jusqu'à 100% financé",
  "PassBot · bilan en 5 minutes",
  "Transitions Pro",
  "Jusqu'à 24 mois finançables",
];
// Piste dupliquée pour un défilement sans couture (-50% = 1 cycle).
const loop = [...items, ...items];
---

<div class="lpt-ticker" role="complementary" aria-label="Atouts LaPasseTech">
  <div class="lpt-ticker__viewport">
    <ul class="lpt-ticker__track">
      {
        loop.map((label, i) => (
          <li class="lpt-ticker__item" aria-hidden={i >= items.length ? "true" : undefined}>
            <span class="lpt-ticker__dot" aria-hidden="true">◆</span>
            <span class="lpt-ticker__text">{label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .lpt-ticker {
    background: var(--lpt-caramel-deep);
    color: var(--lpt-cream);
    overflow: hidden;
    height: 38px;
    display: flex;
    align-items: center;
  }
  .lpt-ticker__viewport {
    flex: 1;
    overflow: hidden;
  }
  .lpt-ticker__track {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    animation: lpt-ticker-scroll 32s linear infinite;
  }
  .lpt-ticker:hover .lpt-ticker__track {
    animation-play-state: paused;
  }
  .lpt-ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    white-space: nowrap;
    padding: 0 8px;
  }
  .lpt-ticker__text {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: var(--fw-semi);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lpt-cream);
  }
  .lpt-ticker__dot {
    color: var(--lpt-yellow);
    font-size: 7px;
  }

  @keyframes lpt-ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lpt-ticker__viewport { overflow-x: auto; }
    .lpt-ticker__track { animation: none; }
  }
</style>
