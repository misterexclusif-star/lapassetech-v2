---
/**
 * Ticker — bandeau de liens rapides en haut de page.
 * Marquee en CSS pur (pas de JS), boucle continue via duplication de la piste.
 * Respecte prefers-reduced-motion (animation désactivée → liste statique scrollable).
 */
const items = [
  { label: "Faire mon bilan gratuit", href: "/bilan" },
  { label: "Le guide des métiers du digital (PDF)", href: "/ressources" },
  { label: "CPF financé à 100 %", href: "/articles" },
  { label: "Derniers articles", href: "/articles" },
  { label: "Fiches métiers", href: "/metiers" },
  { label: "POEI · France Travail", href: "/articles" },
];
// La piste est dupliquée pour un défilement sans couture.
const loop = [...items, ...items];
---

<div class="lpt-ticker" role="complementary" aria-label="Liens rapides">
  <span class="lpt-ticker__label lpt-mono" aria-hidden="true">// raccourcis :</span>
  <div class="lpt-ticker__viewport">
    <ul class="lpt-ticker__track">
      {
        loop.map((item, i) => (
          <li class="lpt-ticker__item" aria-hidden={i >= items.length ? "true" : undefined}>
            <a href={item.href}>{item.label}</a>
            <span class="lpt-ticker__sep" aria-hidden="true">·</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .lpt-ticker {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--lpt-black);
    color: var(--text-on-dark);
    padding: 0 var(--nav-pad-x);
    height: 36px;
    overflow: hidden;
    font-size: 12.5px;
  }
  .lpt-ticker__label {
    flex-shrink: 0;
    color: var(--tech);
    font-size: 11px;
  }
  .lpt-ticker__viewport {
    flex: 1;
    overflow: hidden;
  }
  .lpt-ticker__track {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    animation: lpt-ticker-scroll 38s linear infinite;
  }
  .lpt-ticker:hover .lpt-ticker__track {
    animation-play-state: paused;
  }
  .lpt-ticker__item {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .lpt-ticker__item a {
    color: var(--text-faint);
    transition: color 0.15s ease;
  }
  .lpt-ticker__item a:hover {
    color: var(--text-on-dark);
  }
  .lpt-ticker__sep {
    color: var(--lpt-gray);
    margin: 0 18px;
  }

  @keyframes lpt-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* la piste contient 2× les items → -50% = un cycle complet sans couture */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lpt-ticker__viewport {
      overflow-x: auto;
    }
    .lpt-ticker__track {
      animation: none;
    }
  }
</style>
