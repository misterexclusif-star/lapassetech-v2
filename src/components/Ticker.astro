---
/**
 * Ticker — bandeau d'actus financement/reconversion sous le Header (v4.5).
 * Fond marron foncé, mono crème minuscule, séparateur « // » terracotta.
 * Marquee CSS pur ; prefers-reduced-motion → bandeau statique défilable.
 * Les items sont datés : c'est le module « site vivant » du feel média.
 */
// Items édités dans Keystatic (singleton « Bandeau d'actus ») → src/data/ticker.json.
// Syntaxe : **texte** = gras crème. Le HTML est échappé avant conversion.
import tickerData from "../data/ticker.json";

const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const toHtml = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, "<b>$1</b>");

const items = (tickerData.items ?? []).map(toHtml);
// Piste dupliquée pour un défilement sans couture (-50% = 1 cycle).
const loop = [...items, ...items];
---

<div class="lpt-ticker" role="complementary" aria-label="Actualités financement et reconversion">
  <div class="lpt-ticker__viewport">
    <ul class="lpt-ticker__track">
      {
        loop.map((html, i) => (
          <li class="lpt-ticker__item" aria-hidden={i >= items.length ? "true" : undefined}>
            <span class="lpt-ticker__text" set:html={html} />
            <span class="lpt-ticker__sep" aria-hidden="true">//</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .lpt-ticker {
    background: var(--caramel-deep);
    color: var(--creme);
    overflow: hidden;
    border-bottom: 2px solid var(--noir);
    padding: 9px 0;
    display: flex;
    align-items: center;
  }
  .lpt-ticker__viewport {
    flex: 1;
    overflow: hidden;
  }
  .lpt-ticker__track {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    animation: lpt-ticker-scroll 46s linear infinite;
  }
  .lpt-ticker:hover .lpt-ticker__track {
    animation-play-state: paused;
  }
  .lpt-ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    white-space: nowrap;
    padding: 0 18px 0 0;
  }
  .lpt-ticker__item:first-child {
    padding-left: 18px;
  }
  .lpt-ticker__text {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: rgba(248, 244, 235, 0.82);
  }
  .lpt-ticker__text :global(b) {
    color: var(--creme);
    font-weight: 600;
  }
  .lpt-ticker__sep {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--terracotta);
  }

  @keyframes lpt-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lpt-ticker__viewport {
      overflow-x: auto;
    }
    .lpt-ticker__track {
      animation: none;
    }
  }

  /* mobile/tablette (breakpoint du burger) : le bandeau mange la hauteur
     du premier écran et ses infos existent déjà dans les sections */
  @media (max-width: 980px) {
    .lpt-ticker {
      display: none;
    }
  }
</style>
