---
/**
 * HomepageHero — 2 colonnes (aligné maquette MJ v4).
 * Gauche : eyebrow mono + titre (mark caramel) + lead + 2 CTA + 3 pills.
 * Droite : grande photo de couverture DYNAMIQUE (défilement auto + survol d'un
 *          article = sa photo) + liste "À lire maintenant" 01/02/03.
 *
 * Les `cover` sont partagés avec les pages article correspondantes (Phase 2 :
 * Unsplash temporaires, validés client).
 */
import Button from "../components/Button.astro";

const reads = [
  {
    n: "01",
    cat: "Reconversion",
    title: "16 ans en marketing : comment j'ai basculé dans la tech à 40 ans",
    meta: "4 mars 2026 · Témoignage",
    href: "/articles/exemple-reconversion-40-ans",
    cover: "https://images.unsplash.com/photo-1531427186611-ecfd6d936c79?w=760&h=520&fit=crop&crop=faces&q=80",
    alt: "Un homme d'une quarantaine d'années",
  },
  {
    n: "02",
    cat: "Financement",
    title: "POEI, CPF, Transitions Pro : lequel choisir pour ta reconversion ?",
    meta: "18 fév. 2026 · Guide",
    href: "/articles",
    cover: "https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=760&h=520&fit=crop&q=80",
    alt: "Une réunion professionnelle",
  },
  {
    n: "03",
    cat: "Métiers du digital",
    title: "Business Analyst Salesforce : le métier que personne ne t'a expliqué",
    meta: "27 fév. 2026 · Fiche métier",
    href: "/articles",
    cover: "https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=760&h=520&fit=crop&crop=faces&q=80",
    alt: "Une professionnelle devant son ordinateur",
  },
];
---

<section class="lpt-section lpt-section--cream hero">
  <div class="lpt-container hero__grid">
    <div class="hero__col">
      <div class="lpt-eyebrow lpt-eyebrow--mono">// reconversion sans bullshit · mai 2026</div>
      <h1>
        Le digital, c'est pas <span class="lpt-mark">réservé aux autres.</span>
      </h1>
      <p class="hero__lead">
        Métiers, formations, financements — tout ce que j'aurais aimé savoir
        avant de me reconvertir. <strong>Par quelqu'un qui l'a vraiment vécu.</strong>
      </p>
      <div class="hero__cta">
        <Button variant="primary" href="/bilan" label="Faire mon diagnostic gratuit" />
        <Button variant="outline" href="/ressources" label="Guide gratuit · 20 pages" arrow={false} />
      </div>
      <div class="hero__pills">
        <span class="lpt-pill"><b>5 min</b> · 100 % gratuit</span>
        <span class="lpt-pill"><b>CPF</b> financé à 100 %</span>
        <span class="lpt-pill"><b>POEI</b> · CDI avant la formation</span>
      </div>
    </div>

    <div class="hero__col hero__media">
      <div class="hero__cover" data-cover>
        {
          reads.map((r, i) => (
            <a class="hero__slide" href={r.href} data-slide={i} aria-hidden={i !== 0 ? "true" : "false"}>
              <img src={r.cover} alt={r.alt} loading={i === 0 ? "eager" : "lazy"} />
              <span class="hero__slide-cat">{r.cat}</span>
              <span class="hero__slide-title">{r.title}</span>
            </a>
          ))
        }
      </div>

      <div class="hero__reads">
        <div class="lpt-eyebrow hero__reads-head">À lire maintenant</div>
        <ol class="hero__reads-list">
          {
            reads.map((r, i) => (
              <li class="hero__read" data-target={i}>
                <span class="hero__read-num">{r.n}</span>
                <div class="hero__read-body">
                  <span class="hero__read-cat">{r.cat}</span>
                  <a class="hero__read-title" href={r.href}>{r.title}</a>
                  <div class="hero__read-meta">{r.meta}</div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  // Cover dynamique : défilement auto + survol d'un article = sa photo.
  const cover = document.querySelector<HTMLElement>("[data-cover]");
  const items = Array.from(document.querySelectorAll<HTMLElement>(".hero__read[data-target]"));
  if (cover) {
    const slides = Array.from(cover.querySelectorAll<HTMLElement>(".hero__slide"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let idx = 0;
    let timer: number | undefined;

    const show = (i: number) => {
      idx = i;
      slides.forEach((s, k) => {
        s.style.opacity = k === i ? "1" : "0";
        s.setAttribute("aria-hidden", k === i ? "false" : "true");
      });
      items.forEach((it, k) => it.classList.toggle("is-active", k === i));
    };
    const start = () => {
      if (reduce) return;
      timer = window.setInterval(() => show((idx + 1) % slides.length), 4000);
    };
    const stop = () => { if (timer) window.clearInterval(timer); };

    items.forEach((it, k) => {
      it.addEventListener("mouseenter", () => { stop(); show(k); });
      it.addEventListener("mouseleave", () => start());
    });
    show(0);
    start();
  }
</script>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: start;
  }
  h1 {
    margin-top: 22px;
    font-size: 56px;
  }
  h1 .lpt-mark {
    line-height: 1.25;
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--text-body);
    line-height: 1.55;
    max-width: 520px;
    margin-top: 26px;
  }
  .hero__lead strong {
    color: var(--text-strong);
    font-weight: var(--fw-semi);
  }
  .hero__cta {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .hero__pills {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  /* ── Cover dynamique ── */
  .hero__media {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero__cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--lpt-beige);
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
    display: block;
  }
  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* dégradé bas pour lisibilité du titre */
  .hero__slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(26, 23, 20, 0) 38%, rgba(26, 23, 20, 0.82) 100%);
  }
  .hero__slide-cat {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    background: var(--accent);
    color: #fff;
    font-size: 10px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
  }
  .hero__slide-title {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 16px;
    z-index: 2;
    color: #fff;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 18px;
    line-height: 1.25;
  }

  /* ── À lire maintenant ── */
  .hero__reads-head {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .hero__reads-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero__read {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    padding: 15px 12px 15px 0;
    border-bottom: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: background 0.15s ease;
  }
  .hero__read:last-child {
    border-bottom: 0;
  }
  .hero__read.is-active {
    background: rgba(156, 90, 44, 0.06);
  }
  .hero__read-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    color: var(--lpt-caramel);
    letter-spacing: -0.02em;
    line-height: 1.2;
    padding-left: 8px;
  }
  .hero__read-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hero__read-cat {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lpt-green-deep);
  }
  .hero__read-title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 15px;
    line-height: 1.28;
    color: var(--text-strong);
    transition: color 0.15s ease;
  }
  .hero__read:hover .hero__read-title {
    color: var(--accent-strong);
  }
  .hero__read-meta {
    font-size: 11.5px;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    h1 {
      font-size: 44px;
    }
  }
</style>
