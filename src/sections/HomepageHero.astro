---
/**
 * HomepageHero — 2 colonnes.
 * Gauche : eyebrow + titre + sous-titre + 2 CTA.
 * Droite : photo (placeholder) + 3 proof points.
 */
import Button from "../components/Button.astro";

const proofs = [
  { k: "Bilan", v: "10 min" },
  { k: "Coût", v: "0 €" },
  { k: "Engagement", v: "Aucun" },
];
---

<section class="lpt-section lpt-section--cream hero">
  <div class="lpt-container hero__grid">
    <div class="hero__col">
      <div class="lpt-eyebrow">Reconversion vers le digital</div>
      <h1>
        Le digital, c'est pas
        <em class="lpt-em">réservé aux autres.</em>
      </h1>
      <p class="hero__lead">
        Métiers, formations financées à 100 %, parcours qui te ressemblent.
        Expliqué simplement — par quelqu'un qui a fait le chemin.
      </p>
      <div class="hero__cta">
        <Button variant="primary" href="/bilan" label="Faire mon bilan gratuit" />
        <Button variant="outline" href="#etapes" label="Comment ça marche" arrow={false} />
      </div>
      <div class="hero__pills">
        <span class="lpt-pill"><b>5 min</b> · 100 % gratuit</span>
        <span class="lpt-pill"><b>CPF</b> financé à 100 %</span>
      </div>
    </div>

    <div class="hero__col hero__media">
      <div class="hero__photo" role="img" aria-label="Portrait de Guy, fondateur">
        <span class="lpt-mono">photo · Guy</span>
      </div>
      <ul class="hero__proofs">
        {
          proofs.map((p) => (
            <li>
              <span class="hero__proof-k lpt-eyebrow">{p.k}</span>
              <span class="hero__proof-v">{p.v}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
  }
  h1 {
    margin-top: 24px;
    font-size: 60px;
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--text-body);
    line-height: 1.55;
    max-width: 520px;
    margin-top: 24px;
  }
  .hero__cta {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .hero__pills {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .hero__media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--lpt-beige);
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
    color: var(--text-muted);
    font-size: 12px;
  }
  .hero__proofs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .hero__proofs li {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hero__proof-v {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 22px;
    color: var(--text-strong);
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    h1 {
      font-size: 44px;
    }
  }
</style>
