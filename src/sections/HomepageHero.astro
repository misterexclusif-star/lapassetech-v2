---
/**
 * HomepageHero — v4.5.
 * Gauche : promesse (surligneur jaune) + CTA jaune/ghost + badges.
 * Droite : deck « à la une cette semaine » — 4 cartes-articles empilées,
 * carrousel autoplay (pause hover/focus/reduced-motion), points de navigation.
 * Alimenté par les articles `featured: true` (fallback : les 4 plus récents).
 */
import { getCollection } from "astro:content";

const all = await getCollection("articles", ({ data }) => !data.draft);
const byDate = [...all].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = byDate.filter((a) => a.data.featured).slice(0, 4);
const deck = featured.length >= 4 ? featured : byDate.slice(0, 4);

/** Chip catégorie : mapping tag → classe couleur (mêmes teintes que la maquette). */
const catClass = (tag: string) => {
  const t = tag.toLowerCase();
  if (t.includes("reconversion")) return "jaune";
  if (t.includes("financement")) return "caramel";
  if (t.includes("droit")) return "noir";
  return "blanc";
};
const fmtDate = (d: Date) =>
  d.toLocaleDateString("fr-FR", { month: "short", year: "numeric" });
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow rv">reconversion sans bullshit · 2026</span>
      <h1 class="rv d1">
        Le digital, c'est pas <span class="hl">réservé</span> aux <em class="s">autres.</em>
      </h1>
      <p class="hero-lead rv d2">
        Métiers, formations, financements — tout ce que j'aurais aimé savoir avant de me
        reconvertir. <b
          >Reconverti à 38 ans, après 16 ans de marketing, via une POEI, sans diplôme
          informatique.</b
        > Je suis <b>passé</b> dans la <b>Tech</b>. Toi aussi, tu peux.
      </p>
      <div class="hero-ctas rv d3">
        <a href="/bilan" class="btn btn-jaune">Faire mon diagnostic gratuit →</a>
        <a href="#guide" class="btn btn-ghost">Guide gratuit · 20 pages</a>
      </div>
      <div class="hero-badges rv d4">
        <span class="badge j">100 % vécu · POEI</span>
        <span class="badge c">financements à jour 2026</span>
        <span class="badge">bilan 5 min · gratuit</span>
      </div>
    </div>

    <div class="deck-zone rv d2">
      <p class="deck-label">à la une cette semaine</p>
      <div class="deck" id="deck" aria-roledescription="carrousel" aria-label="Articles à la une">
        {
          deck.map((a, i) => (
            <a href={`/articles/${a.id}`} class={`dcard p${i}`} data-i={i}>
              <span class="tape" aria-hidden="true" />
              <div class="dcover" aria-hidden="true">
                {a.data.cover ? (
                  <img
                    src={a.data.cover}
                    alt=""
                    loading={i === 0 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                  />
                ) : (
                  <div class={`cover-fb fb-${catClass(a.data.tag)}`}>
                    <span>{a.data.title.slice(0, 2).toUpperCase()}</span>
                  </div>
                )}
              </div>
              <div class="dbody">
                <span class={`dcat ${catClass(a.data.tag)}`}>{a.data.tag.toLowerCase()}</span>
                <h3>{a.data.title}</h3>
                <span class="ddate">{fmtDate(a.data.date)}</span>
              </div>
            </a>
          ))
        }
      </div>
      <div class="deck-dots" role="tablist" aria-label="Choisir l'article affiché">
        {
          deck.map((_, i) => (
            <button
              type="button"
              data-goto={i}
              aria-current={i === 0 ? "true" : "false"}
              aria-label={`Article ${i + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 90px;
    position: relative;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }
  .hero h1 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-size: clamp(2.5rem, 5.6vw, 4.3rem);
    margin: 10px 0 20px;
  }
  .hero h1 .hl {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    z-index: 0;
  }
  .hero h1 .hl::after {
    content: "";
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0.06em;
    height: 0.34em;
    background: var(--jaune);
    z-index: -1;
    transform: rotate(-1deg);
  }
  .hero-lead {
    font-size: 1.15rem;
    max-width: 520px;
    color: rgba(26, 23, 20, 0.82);
  }
  .hero-lead b {
    color: var(--noir);
  }
  .hero-ctas {
    display: flex;
    gap: 16px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .hero-badges {
    display: flex;
    gap: 10px;
    margin-top: 26px;
    flex-wrap: wrap;
  }

  /* deck à la une */
  .deck-zone {
    max-width: 420px;
    margin-left: auto;
    width: 100%;
  }
  .deck-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: var(--fw-semi);
    color: var(--caramel);
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-bottom: 14px;
    justify-content: center;
  }
  .deck-label::before,
  .deck-label::after {
    content: "";
    height: 1.5px;
    background: var(--caramel-16);
    flex: 1;
  }
  .deck {
    position: relative;
    height: 440px;
  }
  .dcard {
    position: absolute;
    inset: 0;
    background: #fff;
    border: 2px solid var(--noir);
    border-radius: 16px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--noir);
    box-shadow: var(--shadow-pop);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.55s ease;
    will-change: transform;
  }
  .dcard .tape {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
    width: 104px;
    height: 28px;
    background: var(--caramel-16);
    border: 1px dashed var(--caramel);
    border-radius: 3px;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .dcard.p0 {
    transform: rotate(1.4deg);
    z-index: 4;
    opacity: 1;
  }
  .dcard.p0 .tape {
    opacity: 1;
  }
  .dcard.p1 {
    transform: rotate(-3.2deg) translate(-16px, 12px) scale(0.97);
    z-index: 3;
    opacity: 1;
  }
  .dcard.p2 {
    transform: rotate(3.6deg) translate(14px, 20px) scale(0.94);
    z-index: 2;
    opacity: 0.88;
  }
  .dcard.p3 {
    transform: rotate(-1.2deg) translateY(26px) scale(0.91);
    z-index: 1;
    opacity: 0.6;
  }
  .dcard.p0:hover {
    transform: rotate(0) translateY(-4px);
  }
  .dcover {
    height: 210px;
    border: 2px solid var(--noir);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    flex: none;
    background: var(--caramel-10);
  }
  .dcover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cover-fb {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 3rem;
    letter-spacing: -0.03em;
  }
  .fb-noir { background: var(--noir); color: var(--terracotta); }
  .fb-jaune { background: var(--jaune); color: var(--noir); }
  .fb-caramel { background: var(--caramel); color: var(--creme); }
  .fb-blanc { background: var(--creme); color: var(--caramel); }
  .dbody {
    padding: 16px 8px 6px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .dcat {
    font-family: var(--mono);
    font-size: 0.64rem;
    font-weight: var(--fw-semi);
    border: 1.5px solid var(--noir);
    border-radius: var(--radius-pill);
    padding: 4px 11px;
    align-self: flex-start;
  }
  .dcat.jaune { background: var(--jaune); color: var(--noir); }
  .dcat.caramel { background: var(--caramel); color: var(--creme); border-color: var(--caramel); }
  .dcat.noir { background: var(--noir); color: var(--creme); }
  .dcat.blanc { background: #fff; color: var(--noir); }
  .dcard h3 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.12rem;
    line-height: 1.22;
    flex: 1;
  }
  .ddate {
    font-family: var(--mono);
    font-size: 0.66rem;
    color: var(--caramel);
  }
  .deck-dots {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-top: 26px;
  }
  .deck-dots button {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--noir);
    background: var(--creme);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .deck-dots button[aria-current="true"] {
    background: var(--jaune);
    transform: scale(1.15);
  }
  .deck-dots button:hover {
    background: var(--caramel-16);
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .deck-zone {
      margin: 30px auto 0;
    }
  }
  @media (max-width: 640px) {
    .deck {
      height: 420px;
    }
    .hero-badges {
      display: none;
    }
  }
</style>

<script>
  // Carrousel du deck : rotation auto 3.2s, pause hover/focus, désactivé en reduced-motion.
  (function () {
    const deck = document.getElementById("deck");
    if (!deck) return;
    const cards = [...deck.querySelectorAll<HTMLElement>(".dcard")];
    const dots = [...document.querySelectorAll<HTMLButtonElement>(".deck-dots button")];
    const n = cards.length;
    let front = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function render() {
      cards.forEach((c) => {
        const i = Number(c.dataset.i);
        const pos = (i - front + n) % n; // 0 = devant
        c.className = "dcard p" + pos;
        c.setAttribute("aria-hidden", pos === 0 ? "false" : "true");
        c.tabIndex = pos === 0 ? 0 : -1;
      });
      dots.forEach((d, i) => d.setAttribute("aria-current", i === front ? "true" : "false"));
    }
    function next() {
      front = (front + 1) % n;
      render();
    }
    function play() {
      if (!reduced && !timer) timer = setInterval(next, 3200);
    }
    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
    }
    dots.forEach((d) =>
      d.addEventListener("click", () => {
        front = Number(d.dataset.goto);
        render();
        stop();
        play();
      }),
    );
    deck.addEventListener("mouseenter", stop);
    deck.addEventListener("mouseleave", play);
    deck.addEventListener("focusin", stop);
    deck.addEventListener("focusout", play);
    render();
    play();
  })();
</script>
