---
/**
 * HomepageHero — 2 colonnes.
 * Gauche : eyebrow + titre + sous-titre + 2 CTA + pills.
 * Droite : photo du fondateur (badge + caption) + bloc "À lire maintenant" (01/02/03).
 */
import Button from "../components/Button.astro";

const reads = [
  {
    n: "01",
    cat: "Reconversion",
    title: "16 ans en marketing : comment j'ai basculé dans la tech à 40 ans",
    meta: "4 mars 2026 · 7 min",
    href: "/articles/exemple-reconversion-40-ans",
  },
  {
    n: "02",
    cat: "Financement",
    title: "POEI, CPF, Transitions Pro : lequel choisir pour ta reconversion ?",
    meta: "18 fév. 2026 · 6 min",
    href: "/articles",
  },
  {
    n: "03",
    cat: "Métiers du digital",
    title: "Les 5 familles de métiers du digital : trouve celle qui te correspond",
    meta: "27 fév. 2026 · 5 min",
    href: "/articles",
  },
];
---

<section class="lpt-section lpt-section--cream hero">
  <div class="lpt-container hero__grid">
    <div class="hero__col">
      <div class="lpt-eyebrow">Reconversion vers le digital</div>
      <h1>
        Le digital, c'est pas
        <em class="lpt-em">réservé aux autres.</em>
      </h1>
      <p class="hero__lead">
        Métiers, formations financées à 100 %, parcours qui te ressemblent.
        Expliqué simplement — par quelqu'un qui a fait le chemin.
      </p>
      <div class="hero__cta">
        <Button variant="primary" href="/bilan" label="Faire mon bilan gratuit" />
        <Button variant="outline" href="#etapes" label="Comment ça marche" arrow={false} />
      </div>
      <div class="hero__pills">
        <span class="lpt-pill"><b>5 min</b> · 100 % gratuit</span>
        <span class="lpt-pill"><b>CPF</b> financé à 100 %</span>
      </div>
    </div>

    <div class="hero__col hero__media">
      <figure class="hero__portrait">
        <div class="hero__photo" role="img" aria-label="Portrait de Guy, fondateur de LaPasseTech">
          <span class="hero__badge">Le fondateur</span>
          <span class="lpt-mono hero__photo-label">photo · Guy</span>
        </div>
        <figcaption class="hero__caption">
          Guy · 16 ans marketing → <strong>Business Analyst Salesforce</strong>
        </figcaption>
      </figure>

      <div class="hero__reads">
        <div class="lpt-eyebrow hero__reads-head">À lire maintenant</div>
        <ol class="hero__reads-list">
          {
            reads.map((r) => (
              <li class="hero__read">
                <span class="hero__read-num">{r.n}</span>
                <div class="hero__read-body">
                  <span class="hero__read-cat">{r.cat}</span>
                  <a class="hero__read-title" href={r.href}>{r.title}</a>
                  <div class="hero__read-meta">{r.meta}</div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  h1 {
    margin-top: 24px;
    font-size: 60px;
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--text-body);
    line-height: 1.55;
    max-width: 520px;
    margin-top: 24px;
  }
  .hero__cta {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .hero__pills {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  /* ── Colonne droite ── */
  .hero__media {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero__portrait {
    margin: 0;
  }
  .hero__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    background: var(--lpt-beige);
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .hero__photo-label {
    color: var(--text-muted);
    font-size: 12px;
  }
  .hero__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
  }
  .hero__caption {
    font-size: 13px;
    color: var(--text-body);
    margin-top: 14px;
    line-height: 1.5;
  }
  .hero__caption strong {
    color: var(--text-strong);
    font-weight: var(--fw-semi);
  }

  /* ── À lire maintenant ── */
  .hero__reads-head {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .hero__reads-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .hero__read {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }
  .hero__read:last-child {
    border-bottom: 0;
  }
  .hero__read-num {
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: 22px;
    color: var(--accent);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
  }
  .hero__read-body {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .hero__read-cat {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lpt-green-deep);
  }
  .hero__read-title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 15.5px;
    line-height: 1.3;
    color: var(--text-strong);
    transition: color 0.15s ease;
  }
  .hero__read-title:hover {
    color: var(--accent-strong);
  }
  .hero__read-meta {
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    h1 {
      font-size: 44px;
    }
  }
</style>
