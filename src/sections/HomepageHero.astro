---
/**
 * HomepageHero — 2 colonnes.
 * Gauche : eyebrow + titre + sous-titre + 2 CTA + pills.
 * Droite : photo fondateur (paysage, badge + caption) + bloc "À lire maintenant"
 *          (01/02/03, chaque article avec vignette paysage).
 *
 * NB Phase 2 : photos Unsplash temporaires (validées par le client) en attendant
 * les visuels définitifs ; remplaçables par les images Keystatic plus tard.
 */
import Button from "../components/Button.astro";

const UNSPLASH = (id: string, w = 200, h = 132) =>
  `https://images.unsplash.com/photo-${id}?w=${w}&h=${h}&fit=crop&crop=faces&q=80`;

const founderImg =
  "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=720&h=440&fit=crop&crop=faces&q=80";

const reads = [
  {
    n: "01",
    cat: "Reconversion",
    title: "16 ans en marketing : comment j'ai basculé dans la tech à 40 ans",
    meta: "4 mars 2026 · 7 min",
    href: "/articles/exemple-reconversion-40-ans",
    img: UNSPLASH("1531427186611-ecfd6d936c79"), // homme ~40 ans
    alt: "Un homme d'une quarantaine d'années",
  },
  {
    n: "02",
    cat: "Financement",
    title: "POEI, CPF, Transitions Pro : lequel choisir pour ta reconversion ?",
    meta: "18 fév. 2026 · 6 min",
    href: "/articles",
    img: UNSPLASH("1521737604893-d14cc237f11d"), // réunion professionnelle
    alt: "Une réunion professionnelle autour d'un ordinateur",
  },
  {
    n: "03",
    cat: "Métiers du digital",
    title: "Les 5 familles de métiers du digital : trouve celle qui te correspond",
    meta: "27 fév. 2026 · 5 min",
    href: "/articles",
    img: UNSPLASH("1494790108377-be9c29b29330"), // femme devant son ordinateur
    alt: "Une femme travaillant devant son ordinateur",
  },
];
---

<section class="lpt-section lpt-section--cream hero">
  <div class="lpt-container hero__grid">
    <div class="hero__col">
      <div class="lpt-eyebrow">Reconversion vers le digital</div>
      <h1>
        Le digital, c'est pas
        <em class="lpt-em">réservé aux autres.</em>
      </h1>
      <p class="hero__lead">
        Métiers, formations financées à 100 %, parcours qui te ressemblent.
        Expliqué simplement — par quelqu'un qui a fait le chemin.
      </p>
      <div class="hero__cta">
        <Button variant="primary" href="/bilan" label="Faire mon bilan gratuit" />
        <Button variant="outline" href="#etapes" label="Comment ça marche" arrow={false} />
      </div>
      <div class="hero__pills">
        <span class="lpt-pill"><b>5 min</b> · 100 % gratuit</span>
        <span class="lpt-pill"><b>CPF</b> financé à 100 %</span>
      </div>
    </div>

    <div class="hero__col hero__media">
      <figure class="hero__portrait">
        <div class="hero__photo">
          <img src={founderImg} alt="Portrait de Guy, fondateur de LaPasseTech" loading="eager" />
          <span class="hero__badge">Le fondateur</span>
        </div>
        <figcaption class="hero__caption">
          Guy · 16 ans marketing → <strong>Business Analyst Salesforce</strong>
        </figcaption>
      </figure>

      <div class="hero__reads">
        <div class="lpt-eyebrow hero__reads-head">À lire maintenant</div>
        <ol class="hero__reads-list">
          {
            reads.map((r) => (
              <li class="hero__read">
                <span class="hero__read-num">{r.n}</span>
                <a class="hero__read-thumb" href={r.href}>
                  <img src={r.img} alt={r.alt} loading="lazy" />
                </a>
                <div class="hero__read-body">
                  <span class="hero__read-cat">{r.cat}</span>
                  <a class="hero__read-title" href={r.href}>{r.title}</a>
                  <div class="hero__read-meta">{r.meta}</div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: start;
  }
  h1 {
    margin-top: 24px;
    font-size: 56px;
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--text-body);
    line-height: 1.55;
    max-width: 520px;
    margin-top: 24px;
  }
  .hero__cta {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .hero__pills {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  /* ── Colonne droite ── */
  .hero__media {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .hero__portrait {
    margin: 0;
  }
  .hero__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10; /* paysage */
    border-radius: var(--radius-2xl);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--lpt-beige);
  }
  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    box-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.4);
  }
  .hero__caption {
    font-size: 13px;
    color: var(--text-body);
    margin-top: 12px;
    line-height: 1.5;
  }
  .hero__caption strong {
    color: var(--text-strong);
    font-weight: var(--fw-semi);
  }

  /* ── À lire maintenant ── */
  .hero__reads-head {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .hero__reads-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero__read {
    display: grid;
    grid-template-columns: 28px 92px 1fr;
    gap: 14px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .hero__read:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .hero__read-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    color: var(--lpt-caramel);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero__read-thumb {
    display: block;
    width: 92px;
    height: 60px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--lpt-beige);
  }
  .hero__read-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero__read-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hero__read-cat {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lpt-green-deep);
  }
  .hero__read-title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 14.5px;
    line-height: 1.28;
    color: var(--text-strong);
    transition: color 0.15s ease;
  }
  .hero__read-title:hover {
    color: var(--accent-strong);
  }
  .hero__read-meta {
    font-size: 11.5px;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    h1 {
      font-size: 44px;
    }
  }
</style>
