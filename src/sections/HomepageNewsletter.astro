---
/**
 * HomepageNewsletter — fond noir.
 * Formulaire câblé sur POST /api/subscribe (type: newsletter → groupe MailerLite "Newsletter").
 */
---

<section class="lpt-section lpt-section--dark newsletter">
  <div class="lpt-container newsletter__inner">
    <div class="newsletter__col">
      <div class="lpt-eyebrow newsletter__eyebrow">La newsletter</div>
      <h2 class="newsletter__title">
        2 fois par semaine, <em class="newsletter__accent">un pas de plus.</em>
      </h2>
      <p class="newsletter__sub">
        Un article qui t'éclaire, une ressource que tu peux utiliser le soir-même.
        Sans bullshit, sans jargon. Désabonnement en un clic.
      </p>
    </div>

    <form id="nl-form" class="newsletter__form" novalidate>
      <label class="newsletter__label" for="nl-email">Ton email</label>
      <div class="newsletter__row">
        <input
          class="lpt-input lpt-input--on-dark"
          type="email"
          id="nl-email"
          name="email"
          placeholder="prenom@email.com"
          required
          autocomplete="email"
        />
        <button type="submit" class="lpt-btn lpt-btn--cta" id="nl-btn">
          <span class="nl-btn-label">Je m'abonne <span class="lpt-btn__arrow" aria-hidden="true">→</span></span>
          <span class="nl-btn-loading" aria-hidden="true" style="display:none;">Envoi…</span>
        </button>
      </div>
      <p class="newsletter__error" id="nl-error" role="alert" aria-live="polite"></p>
      <p class="newsletter__note" id="nl-note">Rejoins les reconverti·es qui avancent chaque semaine.</p>
      <p class="newsletter__success" id="nl-success" role="status" style="display:none;">
        ✅ <strong>Tu es inscrit·e !</strong> Vérifie ta boîte mail pour confirmer.
      </p>
    </form>
  </div>
</section>

<style>
  .newsletter__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .newsletter__eyebrow {
    color: var(--text-faint);
  }
  .newsletter__title {
    color: var(--text-on-dark);
    margin-top: 16px;
  }
  .newsletter__accent {
    font-style: normal;
    font-weight: var(--fw-black);
    color: var(--lpt-yellow);
  }
  .newsletter__sub {
    color: var(--text-faint);
    font-size: var(--fs-lead);
    line-height: 1.6;
    margin-top: 20px;
    max-width: 480px;
  }
  .newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .newsletter__label {
    font-size: 13px;
    font-weight: var(--fw-semi);
    color: var(--text-on-dark);
  }
  .newsletter__row {
    display: flex;
    gap: 10px;
  }
  .newsletter__row .lpt-input {
    flex: 1;
  }
  .newsletter__note {
    font-size: 12.5px;
    color: var(--text-faint);
    margin-top: 4px;
  }
  .newsletter__error {
    font-size: 13px;
    color: #fca5a5;
    min-height: 18px;
    margin: 0;
  }
  .newsletter__success {
    font-size: 14px;
    color: var(--lpt-yellow);
    margin-top: 4px;
  }

  @media (max-width: 980px) {
    .newsletter__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 560px) {
    .newsletter__row {
      flex-direction: column;
    }
  }
</style>

<script>
  const form    = document.getElementById("nl-form") as HTMLFormElement;
  const input   = document.getElementById("nl-email") as HTMLInputElement;
  const btn     = document.getElementById("nl-btn") as HTMLButtonElement;
  const errEl   = document.getElementById("nl-error")!;
  const noteEl  = document.getElementById("nl-note")!;
  const successEl = document.getElementById("nl-success")!;
  const labelEl = btn.querySelector(".nl-btn-label") as HTMLElement;
  const loadEl  = btn.querySelector(".nl-btn-loading") as HTMLElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errEl.textContent = "";

    const email = input.value.trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = "Saisis une adresse email valide.";
      input.focus();
      return;
    }

    // State: loading
    btn.disabled = true;
    labelEl.style.display = "none";
    loadEl.style.display  = "";

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, type: "newsletter" }),
      });
      const data = await res.json();

      if (data.ok) {
        input.style.display = "none";
        btn.style.display   = "none";
        noteEl.style.display = "none";
        successEl.style.display = "";
      } else {
        errEl.textContent = data.error ?? "Une erreur est survenue, réessaie.";
        btn.disabled = false;
        labelEl.style.display = "";
        loadEl.style.display  = "none";
      }
    } catch {
      errEl.textContent = "Erreur réseau, vérifie ta connexion et réessaie.";
      btn.disabled = false;
      labelEl.style.display = "";
      loadEl.style.display  = "none";
    }
  });
</script>
