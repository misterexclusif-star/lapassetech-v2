---
/**
 * HomepageFreins — « Tu te poses laquelle ? » (v4.5, section signature).
 * Fond marron foncé ; 4 cartes-questions pivotées et épinglées, chacune
 * incarnée par un persona (photo + prénom · âge · métier) et ancrée vers
 * la section de la home qui y répond (#financement #metiers #doutes #commencer).
 * Avatars : public/images/personas/*.webp (repli : photo masquée si absente).
 */
// Contenu édité dans Keystatic (singleton « Cartes questions ») → src/data/questions.json.
// Les couleurs/rotations des cartes restent fixées par position (design system).
import questionsData from "../data/questions.json";

const cards = questionsData.items.map((c) => ({
  persona: c.persona,
  job: c.job,
  img: c.img,
  q: c.question,
  go: c.cta,
  href: c.href,
}));
---

<section class="questions">
  <div class="wrap">
    <span class="eyebrow rv">pour qui</span>
    <h2 class="rv d1">Tu te poses <em class="s">laquelle&nbsp;?</em></h2>
    <p class="sub rv d2">
      Quatre doutes que tout le monde garde pour soi. Ils se les sont posés aussi. Chaque carte
      t'emmène directement à la réponse.
    </p>
    <div class="qgrid">
      {
        cards.map((c, i) => (
          <a href={c.href} class={`qcard rv d${i + 1}`}>
            <span class="pin" aria-hidden="true" />
            <div class="qwho">
              <img src={c.img} alt="" loading="lazy" onerror="this.style.display='none'" />
              <span class="qname">
                {c.persona}
                <br />
                {c.job}
              </span>
            </div>
            <h3>{c.q}</h3>
            <span class="qgo">{c.go}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .questions {
    background: var(--caramel-deep);
    color: var(--creme);
    position: relative;
    overflow: hidden;
    padding: 84px 0;
    border-bottom: 2px solid var(--noir);
  }
  .questions .eyebrow {
    color: var(--jaune);
  }
  .questions h2 {
    color: var(--creme);
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .questions .sub {
    color: rgba(248, 244, 235, 0.72);
  }
  .qgrid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
    margin-top: 52px;
  }
  .qcard {
    border: 2px solid var(--noir);
    border-radius: var(--r);
    padding: 26px 22px 22px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 290px;
    position: relative;
    box-shadow: 6px 6px 0 rgba(248, 244, 235, 0.18);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .qcard:nth-child(1) {
    background: var(--jaune);
    color: var(--noir);
    transform: rotate(-1.6deg);
  }
  .qcard:nth-child(2) {
    background: var(--creme);
    color: var(--noir);
    transform: rotate(1.2deg);
  }
  .qcard:nth-child(3) {
    background: var(--caramel);
    color: var(--creme);
    transform: rotate(-1deg);
  }
  .qcard:nth-child(4) {
    background: #fff;
    color: var(--noir);
    transform: rotate(1.6deg);
  }
  .qcard:hover {
    transform: rotate(0) translateY(-6px);
    box-shadow: 8px 10px 0 rgba(248, 244, 235, 0.28);
  }
  .qcard h3 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.32rem;
    line-height: 1.2;
    flex: 1;
    color: inherit; /* la carte caramel a un texte crème — ne pas laisser le h3 global l'assombrir */
  }
  .qcard .qgo {
    font-family: var(--disp);
    font-weight: var(--fw-bold);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.4em;
  }
  .qcard .qgo::after {
    content: "→";
    transition: transform 0.2s;
  }
  .qcard:hover .qgo::after {
    transform: translateX(5px);
  }
  .qcard .pin {
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--creme);
    border: 2px solid var(--noir);
  }
  .qcard:nth-child(3) .pin {
    background: var(--jaune);
  }
  .qwho {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .qwho img {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid var(--noir);
    object-fit: cover;
    background: var(--creme);
  }
  .qwho .qname {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: var(--fw-semi);
    line-height: 1.3;
    opacity: 0.85;
  }

  @media (max-width: 980px) {
    .qgrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .qgrid {
      grid-template-columns: 1fr;
    }
    .qcard {
      min-height: auto;
    }
  }
</style>
