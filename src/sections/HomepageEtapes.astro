---
/**
 * HomepageEtapes — "3 étapes pour passer."
 * 3 blocs horizontaux 01 / 02 / 03.
 */
const steps = [
  {
    n: "01",
    t: "Fais ton bilan",
    d: "8 questions, 10 minutes. PassBot identifie les métiers du digital qui collent à ton profil et t'envoie un plan d'action par email.",
    tag: "Gratuit",
  },
  {
    n: "02",
    t: "Explore ce qui te concerne",
    d: "Articles, ressources, fiches métiers — classés par financement et par niveau. Tu lis seulement ce qui te sert.",
    tag: "Sans jargon",
  },
  {
    n: "03",
    t: "Avance chaque semaine",
    d: "Deux emails par semaine : un article qui t'éclaire, une ressource que tu peux utiliser le soir-même.",
    tag: "Concret",
  },
];
---

<section class="lpt-section etapes" id="etapes">
  <div class="lpt-container">
    <div class="etapes__head">
      <div>
        <div class="lpt-eyebrow">Comment ça marche</div>
        <h2>3 étapes pour <em class="lpt-em">passer.</em></h2>
      </div>
      <p class="etapes__aside">Tu n'as rien à signer. Tu peux tout faire seul·e, à ton rythme.</p>
    </div>

    <ol class="etapes__grid">
      {
        steps.map((s) => (
          <li class="etape">
            <div class="etape__top">
              <span class="etape__num">{s.n}</span>
              <span class="lpt-pill etape__tag">{s.tag}</span>
            </div>
            <h3 class="etape__title">{s.t}</h3>
            <p class="etape__desc">{s.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .etapes__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 48px;
  }
  .etapes__head h2 {
    margin-top: 16px;
  }
  .etapes__aside {
    font-size: 14px;
    color: var(--text-muted);
    max-width: 260px;
    text-align: right;
  }
  .etapes__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--surface-card);
  }
  .etape {
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-left: 1px solid var(--border);
  }
  .etape:first-child {
    border-left: 0;
  }
  .etape__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .etape__num {
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: 44px;
    line-height: 1;
    color: var(--accent);
    letter-spacing: var(--tracking-display);
  }
  .etape__title {
    font-size: 22px;
  }
  .etape__desc {
    font-size: var(--fs-body-sm);
    color: var(--text-body);
    line-height: 1.55;
  }

  @media (max-width: 980px) {
    .etapes__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .etapes__aside {
      text-align: left;
    }
    .etapes__grid {
      grid-template-columns: 1fr;
    }
    .etape {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .etape:first-child {
      border-top: 0;
    }
  }
</style>
