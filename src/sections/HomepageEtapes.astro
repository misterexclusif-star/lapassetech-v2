---
/**
 * HomepageEtapes — « 3 étapes pour passer. » (v4.5).
 * Fond beige bordé ; 3 cartes blanches : label mono étape_0X, grand numéro
 * serif italique terracotta, titre, description, mini-checklist ✓ caramel.
 * Flèches caramel entre les cartes (masquées < 980px).
 */
const steps = [
  {
    label: "étape_01",
    n: "1",
    t: "Fais ton bilan gratuit",
    d: "PassBot te pose 5 questions pour identifier les métiers du digital qui collent à ton profil.",
    checks: ["5 minutes chrono", "résultat reçu par email", "gratuit, sans engagement"],
  },
  {
    label: "étape_02",
    n: "2",
    t: "Explore articles & ressources",
    d: "Comprends les métiers, les financements. Monte en compétences dès maintenant.",
    checks: ["articles par catégorie", "ressources étape par étape"],
  },
  {
    label: "étape_03",
    n: "3",
    t: "Continue à avancer chaque semaine",
    d: "Ton diagnostic arrive par email avec les métiers compatibles. Ensuite, tu avances pas à pas.",
    checks: ["diagnostic personnalisé par email", "un contenu actionnable, 2×/semaine"],
  },
];
---

<section id="etapes" class="etapes">
  <div class="wrap">
    <span class="eyebrow rv">comment ça marche</span>
    <h2 class="rv d1">3 étapes pour <em class="s">passer.</em></h2>
    <p class="sub rv d2">Un chemin clair, gratuit, sans engagement. Tu avances à ton rythme.</p>
    <div class="steps">
      {
        steps.map((s, i) => (
          <article class={`step rv d${i + 1}`}>
            <span class="step-label">{s.label}</span>
            <span class="stepnum">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <ul>
              {s.checks.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .etapes {
    background: var(--beige);
    border-top: 2px solid var(--noir);
    border-bottom: 2px solid var(--noir);
    padding: 84px 0;
  }
  .etapes h2 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px;
    margin-top: 48px;
  }
  .step {
    background: #fff;
    border: 2px solid var(--noir);
    border-radius: var(--r);
    padding: 28px 24px;
    position: relative;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .step:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-pop-sm);
  }
  .step:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -27px;
    top: 44%;
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.5rem;
    color: var(--caramel);
    z-index: 2;
  }
  .step-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: var(--fw-semi);
    background: var(--noir);
    color: var(--creme);
    display: inline-block;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: 16px;
  }
  .stepnum {
    font-family: var(--serif);
    font-style: italic;
    font-size: 3.2rem;
    line-height: 1;
    color: var(--terracotta);
    display: block;
    margin-bottom: 10px;
  }
  .step h3 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.25rem;
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .step p {
    font-size: 0.92rem;
    color: rgba(26, 23, 20, 0.78);
  }
  .step ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .step li {
    font-size: 0.85rem;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .step li::before {
    content: "✓";
    font-weight: var(--fw-black);
    color: var(--caramel);
    flex: none;
  }

  @media (max-width: 980px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .step:not(:last-child)::after {
      display: none;
    }
  }
</style>
