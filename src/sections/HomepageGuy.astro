---
/**
 * HomepageGuy — « La réponse de quelqu'un qui est passé. » (v4.5, ancre #doutes).
 * Polaroid scotché + quote card (guillemet serif géant) + 3 facts (38/16/0).
 * Destination de la carte-question n°3 (Sophie).
 * Portrait : public/images/guy.jpg (vraie photo, fournie le 17/07/2026).
 */
const PORTRAIT =
  "/images/guy.jpg";

const facts = [
  { v: "38", t: "ans à la reconversion" },
  { v: "16", t: "ans de marketing valorisés" },
  { v: "0", t: "diplôme informatique" },
];
---

<section id="doutes" class="doutes">
  <div class="wrap">
    <span class="eyebrow rv">trop vieux, sans diplôme ?</span>
    <h2 class="rv d1">La réponse de quelqu'un qui est <em class="s">passé.</em></h2>
    <div class="doutes-flex">
      <figure class="polaroid rv d1">
        <img src={PORTRAIT} alt="Guy, fondateur de LaPasseTech" loading="lazy" />
        <figcaption>// guy · fondateur — passé en 2022</figcaption>
      </figure>
      <div class="quote-card rv d2">
        <blockquote>
          À 38 ans, sans diplôme informatique et sans réseau dans la tech, on m'a dit que c'était
          trop tard. Mes 16 ans de marketing n'étaient pas un handicap — c'était mon meilleur
          argument. Personne ne me l'avait dit avant.
        </blockquote>
        <div class="qc-sig">
          <span class="chip">G</span>
          <div>
            <b>Guy</b>
            <span class="mono">business analyst salesforce · fondateur</span>
          </div>
        </div>
      </div>
    </div>
    <div class="doutes-facts">
      {
        facts.map((f, i) => (
          <div class={`fact rv d${i + 1}`}>
            <b>{f.v}</b>
            <span>{f.t}</span>
          </div>
        ))
      }
    </div>
    <div class="doutes-cta rv">
      <a href="/a-propos" class="btn btn-ghost">Lire mon parcours complet →</a>
    </div>
  </div>
</section>

<style>
  .doutes {
    padding: 60px 0 84px;
  }
  .doutes h2 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .doutes-flex {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 52px;
    align-items: center;
    max-width: 900px;
    margin: 44px auto 0;
  }
  .polaroid {
    background: #fff;
    border: 2px solid var(--noir);
    border-radius: 10px;
    padding: 12px 12px 16px;
    box-shadow: var(--shadow-pop);
    transform: rotate(-2.5deg);
    width: 230px;
    position: relative;
    margin: 0;
  }
  .polaroid::before {
    content: "";
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%) rotate(2deg);
    width: 96px;
    height: 26px;
    background: var(--caramel-16);
    border: 1px dashed var(--caramel);
    border-radius: 3px;
  }
  .polaroid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border: 2px solid var(--noir);
    border-radius: 6px;
  }
  .polaroid figcaption {
    font-family: var(--mono);
    font-size: 0.66rem;
    color: var(--caramel);
    text-align: center;
    margin-top: 10px;
  }
  .quote-card {
    background: #fff;
    border: 2px solid var(--noir);
    border-radius: var(--r);
    padding: 34px;
    box-shadow: var(--shadow-pop);
    position: relative;
  }
  .quote-card::before {
    content: "«";
    position: absolute;
    top: -34px;
    left: 26px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 5rem;
    color: var(--caramel);
  }
  .quote-card blockquote {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.4rem;
    line-height: 1.4;
    margin: 0;
  }
  .qc-sig {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .qc-sig .chip {
    width: 44px;
    height: 44px;
    background: var(--jaune);
    border: 2px solid var(--noir);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--disp);
    font-weight: var(--fw-black);
    transform: rotate(-5deg);
  }
  .qc-sig b {
    font-family: var(--disp);
  }
  .qc-sig .mono {
    display: block;
    color: var(--caramel);
    font-size: 0.68rem;
  }
  .doutes-facts {
    display: flex;
    gap: 18px;
    justify-content: center;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  .fact {
    border: 2px solid var(--noir);
    border-radius: 14px;
    padding: 16px 22px;
    background: var(--creme);
    text-align: center;
    min-width: 150px;
  }
  .fact b {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.7rem;
    display: block;
  }
  .fact span {
    font-size: 0.8rem;
    color: rgba(26, 23, 20, 0.7);
  }
  .fact:nth-child(2) {
    background: var(--jaune);
  }
  .fact:nth-child(2) span {
    color: var(--noir);
  }
  .doutes-cta {
    margin-top: 40px;
    text-align: center;
  }

  @media (max-width: 980px) {
    .doutes-flex {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 60px;
    }
  }
</style>
