---
/**
 * HomepageTemoignages — « Des parcours qui ressemblent au tien. » (v4.5).
 * Règle éditoriale (spec §6) : ces citations viennent de vraies conversations,
 * PAS d'accompagnements LaPasseTech — le sous-titre le dit explicitement.
 * Pas de CTA « voir tous les parcours » tant que la page n'existe pas.
 * À remplacer par de vrais accompagnés dès que possible.
 */
const items = [
  {
    name: "Bilel · 32 ans",
    path: "livreur → tech support",
    q: "« Je croyais qu'il fallait coder. C'est faux. »",
    chip: "B",
    chipClass: "chip-jaune",
  },
  {
    name: "Issa · 28 ans",
    path: "restauration → data analyst",
    q: "« Formation payée à 100 %. Je ne savais pas que c'était possible. »",
    chip: "I",
    chipClass: "chip-caramel",
  },
  {
    name: "Aïcha · 41 ans",
    path: "congé parental → marketing digital",
    q: "« En 8 mois, j'étais en poste. Sans réseau. »",
    chip: "A",
    chipClass: "chip-creme",
  },
];
---

<section class="parcours">
  <div class="wrap">
    <span class="eyebrow rv">ils sont passés, eux aussi</span>
    <h2 class="rv d1">Des parcours qui <em class="s">ressemblent au tien.</em></h2>
    <p class="sub rv d2">
      Pas des success stories maison : trois conversations réelles, leurs mots tels quels.
    </p>
    <div class="pgrid">
      {
        items.map((it, i) => (
          <article class={`pcard rv d${i + 1}`}>
            <blockquote>{it.q}</blockquote>
            <div class="psig">
              <span class={`chip ${it.chipClass}`}>{it.chip}</span>
              <div>
                <b>{it.name}</b>
                <span class="mono">{it.path}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .parcours {
    background: var(--beige);
    border-top: 2px solid var(--noir);
    border-bottom: 2px solid var(--noir);
    padding: 84px 0;
  }
  .parcours h2 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    margin-top: 48px;
  }
  .pcard {
    background: #fff;
    border: 2px solid var(--noir);
    border-radius: var(--r);
    padding: 28px 24px;
    position: relative;
    transition: transform 0.22s, box-shadow 0.22s;
  }
  .pcard:nth-child(1) {
    transform: rotate(-1deg);
  }
  .pcard:nth-child(2) {
    transform: rotate(0.8deg);
  }
  .pcard:nth-child(3) {
    transform: rotate(-0.6deg);
  }
  .pcard:hover {
    transform: rotate(0) translateY(-5px);
    box-shadow: var(--shadow-pop-sm);
  }
  .pcard blockquote {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.45;
    margin: 0 0 20px;
  }
  .psig {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .psig .chip {
    width: 42px;
    height: 42px;
    border: 2px solid var(--noir);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--disp);
    font-weight: var(--fw-black);
    transform: rotate(-4deg);
  }
  .chip-jaune { background: var(--jaune); }
  .chip-caramel { background: var(--caramel); color: var(--creme); }
  .chip-creme { background: var(--creme); }
  .psig b {
    font-family: var(--disp);
    display: block;
    line-height: 1.2;
  }
  .psig .mono {
    font-size: 0.64rem;
    color: var(--caramel);
  }

  @media (max-width: 980px) {
    .pgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
