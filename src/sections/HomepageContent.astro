---
/**
 * HomepageContent — « S'informer. Agir. » (v4.5, module média).
 * 2 colonnes : derniers articles publiés (liste numérotée) + ressources
 * actionnables (cartes à bordure gauche colorée). Alimenté par les collections.
 * Règle spec : cette liste = derniers publiés ; le deck du hero = sélection
 * « à la une » — les deux ne doivent pas afficher la même chose.
 */
import { getCollection } from "astro:content";

// Une catégorie différente par ligne (pastilles colorées, comme la maquette).
// Pour chaque catégorie : le plus récent HORS deck si possible, sinon celui
// du deck (tant que le catalogue est majoritairement « Métiers du digital »).
const all = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const byTag = new Map<string, (typeof all)[number]>();
for (const a of all) {
  const cur = byTag.get(a.data.tag);
  if (!cur) byTag.set(a.data.tag, a);
  else if (cur.data.featured && !a.data.featured) byTag.set(a.data.tag, a);
}
const diverse = [...byTag.values()];
const rest = all.filter((a) => !diverse.includes(a) && !a.data.featured);
const articles = [...diverse, ...rest].slice(0, 4);

const ressources = (await getCollection("ressources", ({ data }) => !data.draft)).slice(0, 3);

const catClass = (tag: string) => {
  const t = tag.toLowerCase();
  if (t.includes("reconversion")) return "cat-reco";
  if (t.includes("financement")) return "cat-fin";
  if (t.includes("droit")) return "cat-droit";
  if (t.includes("perso")) return "cat-perso";
  return "cat-met";
};
const borderClass = (theme: string) => {
  const t = theme.toLowerCase();
  if (t.includes("financement")) return "bl-jaune";
  if (t.includes("ia")) return "bl-caramel";
  if (t.includes("no-code")) return "bl-terracotta";
  return "bl-noir";
};
const levelLabel = { deb: "débutant", int: "intermédiaire", avance: "avancé" } as const;
const fmtDate = (d: Date) => d.toLocaleDateString("fr-FR", { month: "long", year: "numeric" });
---

<section id="sinformer" class="sinformer">
  <div class="wrap">
    <span class="eyebrow rv">le contenu</span>
    <h2 class="rv d1">S'informer. <em class="s">Agir.</em></h2>
    <p class="sub rv d2">
      Des articles de fond pour comprendre, des ressources actionnables pour avancer — deux
      espaces distincts selon où tu en es.
    </p>
    <div class="media-grid rv d2">
      <div>
        <div class="media-col-head">
          <h3>Articles récents</h3>
          <a href="/articles">Voir tous →</a>
        </div>
        {
          articles.map((a, i) => (
            <a href={`/articles/${a.id}`} class="art-row">
              <span class="art-num">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{a.data.title}</h3>
                <div class="art-meta">
                  <span class={`acat ${catClass(a.data.tag)}`}>{a.data.tag.toLowerCase()}</span>
                  <span class="art-date">{fmtDate(a.data.date)}</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
      <div>
        <div class="media-col-head">
          <h3>Ressources actionnables</h3>
          <a href="/ressources">Voir toutes →</a>
        </div>
        <div class="res-list">
          {
            ressources.map((r) => (
              <a href={`/ressources/${r.id}`} class={`res-card ${borderClass(r.data.theme)}`}>
                <span class="res-tag">
                  {r.data.theme.toLowerCase()} ·{" "}
                  {levelLabel[r.data.level] ?? r.data.level}
                </span>
                <h3>{r.data.title}</h3>
                <p>{r.data.description}</p>
                {r.data.duration && <span class="res-time">{r.data.duration}</span>}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sinformer {
    padding: 84px 0;
  }
  .sinformer h2 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .media-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 52px;
    margin-top: 48px;
    align-items: start;
  }
  .media-col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 2px solid var(--noir);
    padding-bottom: 12px;
    margin-bottom: 4px;
  }
  .media-col-head h3 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .media-col-head a {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: var(--fw-semi);
    color: var(--caramel);
    text-decoration: none;
  }
  .media-col-head a:hover {
    text-decoration: underline;
  }
  .art-row {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 16px;
    align-items: start;
    padding: 20px 8px;
    border-bottom: 2px solid var(--noir-08);
    text-decoration: none;
    color: inherit;
    transition: background 0.18s, padding-left 0.18s;
  }
  .art-row:hover {
    background: #fff;
    padding-left: 16px;
  }
  .art-num {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--caramel);
    padding-top: 4px;
  }
  .art-row h3 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.1rem;
    line-height: 1.25;
    transition: color 0.18s;
    margin: 6px 0 8px;
  }
  .art-row:hover h3 {
    color: var(--caramel);
  }
  .art-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .art-date {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: rgba(26, 23, 20, 0.6);
  }
  .res-list {
    display: grid;
    gap: 18px;
    margin-top: 20px;
  }
  .res-card {
    background: #fff;
    border: 2px solid var(--noir);
    border-left: 8px solid var(--caramel);
    border-radius: 12px;
    padding: 20px 22px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
    display: block;
  }
  .res-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-pop-sm);
  }
  .res-card.bl-jaune { border-left-color: var(--jaune); }
  .res-card.bl-caramel { border-left-color: var(--caramel); }
  .res-card.bl-terracotta { border-left-color: var(--terracotta); }
  .res-card.bl-noir { border-left-color: var(--noir); }
  .res-card .res-tag {
    font-family: var(--mono);
    font-size: 0.64rem;
    font-weight: var(--fw-semi);
    color: var(--caramel);
    display: block;
    margin-bottom: 8px;
  }
  .res-card h3 {
    font-family: var(--disp);
    font-weight: var(--fw-black);
    font-size: 1.05rem;
    margin-bottom: 8px;
  }
  .res-card p {
    font-size: 0.88rem;
    color: rgba(26, 23, 20, 0.75);
    /* chapô sur une seule ligne, comme la maquette */
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .res-card .res-time {
    font-family: var(--mono);
    font-size: 0.66rem;
    background: var(--jaune);
    border: 1.5px solid var(--noir);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    display: inline-block;
    margin-top: 12px;
  }

  @media (max-width: 980px) {
    .media-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>
