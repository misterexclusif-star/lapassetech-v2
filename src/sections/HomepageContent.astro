---
/**
 * HomepageContent — "S'informer. Agir." (aligné maquette MJ v4).
 * Fond illustré humain estompé. 2 espaces distincts :
 *   gauche  = Articles récents (liste numérotée, panneau blanc)
 *   droite  = Ressources actionnables (cartes, panneau caramel clair)
 */
const articles = [
  { n: "01", cat: "Reconversion", title: "16 ans en marketing : comment j'ai basculé dans la tech à 40 ans", meta: "4 mars 2026", href: "/articles/exemple-reconversion-40-ans" },
  { n: "02", cat: "Financement", title: "POEI, CPF, Transitions Pro : lequel choisir pour ta reconversion ?", meta: "18 fév. 2026", href: "/articles" },
  { n: "03", cat: "Métiers", title: "Business Analyst Salesforce : le métier que personne ne t'a expliqué", meta: "27 fév. 2026", href: "/articles" },
  { n: "04", cat: "Droit du travail", title: "Rupture conventionnelle : ce que tu peux vraiment négocier", meta: "12 fév. 2026", href: "/articles" },
];

const ressources = [
  { theme: "Outils IA", level: "Débutant", duration: "15 min", title: "Utiliser Gemini pour booster ta recherche d'emploi", desc: "5 étapes concrètes avec prompts prêts à l'emploi", tags: ["YouTube", "Guide PDF"], href: "/ressources/exemple-gemini-entretien" },
  { theme: "Financement", level: "Débutant", duration: "20 min", title: "Faire sa demande CPF en 20 minutes chrono", desc: "Étape par étape, de la connexion à la validation", tags: ["Guide PDF"], href: "/ressources" },
  { theme: "Compétences", level: "Intermédiaire", duration: "30 min", title: "Construire ton premier site en no-code", desc: "De la page blanche à un site en ligne, sans coder", tags: ["Guide PDF"], href: "/ressources" },
];
---

<section class="lpt-section content">
  <div class="lpt-container content__inner">
    <div class="content__head">
      <h2>S'informer. <em class="lpt-serif-italic" style="color:var(--accent)">Agir.</em></h2>
      <p class="content__sub">
        Articles de fond et ressources actionnables — <strong>deux espaces distincts</strong>
        selon où tu en es.
      </p>
    </div>

    <div class="content__grid">
      <!-- Articles récents -->
      <div class="content__panel content__panel--articles">
        <div class="content__panel-head">
          <span class="lpt-eyebrow">Articles récents</span>
          <a class="content__more" href="/articles">Voir tous →</a>
        </div>
        <ol class="content__articles">
          {
            articles.map((a) => (
              <li class="content__article">
                <span class="content__article-num">{a.n}</span>
                <div class="content__article-body">
                  <span class="content__article-cat">{a.cat}</span>
                  <a class="content__article-title" href={a.href}>{a.title}</a>
                  <span class="content__article-meta">{a.meta}</span>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Ressources actionnables -->
      <div class="content__panel content__panel--ressources">
        <div class="content__panel-head">
          <span class="lpt-eyebrow">Ressources actionnables</span>
          <a class="content__more" href="/ressources">Voir toutes →</a>
        </div>
        <div class="content__ressources">
          {
            ressources.map((r) => (
              <a class="content__res-card" href={r.href}>
                <span class="content__res-meta">{r.theme} · {r.level} · {r.duration}</span>
                <span class="content__res-title">{r.title}</span>
                <span class="content__res-desc">{r.desc}</span>
                <div class="content__res-tags">
                  {r.tags.map((t) => <span class="content__res-tag">{t}</span>)}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .content {
    position: relative;
    background: var(--surface-cream);
    overflow: hidden;
  }
  /* fond illustré humain estompé */
  .content::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1400&h=900&fit=crop&q=70");
    background-size: cover;
    background-position: center;
    opacity: 0.08;
    pointer-events: none;
  }
  .content__inner {
    position: relative;
    z-index: 1;
  }
  .content__head {
    margin-bottom: 40px;
  }
  .content__sub {
    font-size: var(--fs-lead);
    color: var(--text-body);
    margin-top: 14px;
    max-width: 560px;
  }
  .content__sub strong {
    color: var(--text-strong);
    font-weight: var(--fw-semi);
  }
  .content__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }
  .content__panel {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 28px;
  }
  .content__panel--articles {
    background: var(--surface-card);
  }
  .content__panel--ressources {
    background: rgba(156, 90, 44, 0.05);
  }
  .content__panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 16px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .content__more {
    font-size: 13.5px;
    font-weight: var(--fw-bold);
    color: var(--accent-strong);
    white-space: nowrap;
  }

  /* Articles : liste numérotée */
  .content__articles {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .content__article {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .content__article:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .content__article-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 26px;
    color: var(--accent);
    line-height: 1;
  }
  .content__article-body {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .content__article-cat {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lpt-green-deep);
  }
  .content__article-title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 16px;
    line-height: 1.3;
    color: var(--text-strong);
    transition: color 0.15s ease;
  }
  .content__article-title:hover {
    color: var(--accent-strong);
  }
  .content__article-meta {
    font-size: 12px;
    color: var(--text-muted);
  }

  /* Ressources : cartes */
  .content__ressources {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 16px;
  }
  .content__res-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 20px 22px;
    transition: box-shadow 0.18s ease, transform 0.18s ease;
  }
  .content__res-card:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }
  .content__res-meta {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .content__res-title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 17px;
    line-height: 1.25;
    color: var(--text-strong);
  }
  .content__res-desc {
    font-size: 13.5px;
    color: var(--text-body);
    line-height: 1.5;
  }
  .content__res-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 2px;
  }
  .content__res-tag {
    font-family: var(--font-body);
    font-size: 11.5px;
    color: var(--text-body);
    background: var(--surface-cream);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 980px) {
    .content__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
