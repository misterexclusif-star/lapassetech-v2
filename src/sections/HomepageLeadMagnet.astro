---
/**
 * HomepageLeadMagnet — "Le guide des métiers du digital".
 * Formulaire câblé sur POST /api/subscribe (type: guide → groupe MailerLite "Guide PDF").
 */
const bullets = [
  "Les 5 familles de métiers du digital, expliquées simplement",
  "Pour chaque métier : salaire, accessibilité, compétences clés",
  "Les formations finançables à 100 % (CPF, POEI…)",
  "Le test honnête à faire avant d'investir ton CPF",
];
---

<section class="lpt-section guide" id="guide" style="background:var(--surface-page);">
  <div class="lpt-container guide__grid">
    <div class="guide__col">
      <div class="lpt-eyebrow">Guide gratuit · 20 pages</div>
      <h2>Le guide des <em class="lpt-em">métiers du digital.</em></h2>
      <p class="guide__intro">
        Tout ce que j'aurais aimé savoir avant de me reconvertir, réuni dans un PDF clair.
      </p>
      <ul class="guide__bullets">
        {bullets.map((b) => <li class="lpt-check">{b}</li>)}
      </ul>
    </div>

    <div class="guide__col guide__form-col">
      <form id="guide-form" class="guide__form" novalidate>
        <h3 class="guide__form-title">Recevoir le guide gratuitement</h3>
        <p class="guide__form-sub">On t'envoie le PDF par email. Pas de spam, désabonnement en un clic.</p>
        <label class="guide__label" for="guide-email">Ton email</label>
        <input
          class="lpt-input"
          type="email"
          id="guide-email"
          name="email"
          placeholder="prenom@email.com"
          required
          autocomplete="email"
        />
        <p class="guide__error" id="guide-error" role="alert" aria-live="polite"></p>
        <button type="submit" class="lpt-btn lpt-btn--accent guide__submit" id="guide-btn">
          <span class="guide-btn-label">Recevoir le guide <span class="lpt-btn__arrow" aria-hidden="true">→</span></span>
          <span class="guide-btn-loading" aria-hidden="true" style="display:none;">Envoi…</span>
        </button>
        <div class="guide__success" id="guide-success" role="status" style="display:none;">
          <span class="guide__success-icon">✅</span>
          <div>
            <strong>C'est parti !</strong><br/>
            Vérifie ta boîte mail — le guide est en route.
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .guide__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .guide__col h2 {
    margin-top: 16px;
  }
  .guide__intro {
    font-size: var(--fs-lead);
    color: var(--text-body);
    margin-top: 16px;
    max-width: 460px;
  }
  .guide__bullets {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .guide__form {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .guide__form-title {
    font-size: 20px;
  }
  .guide__form-sub {
    font-size: 13.5px;
    color: var(--text-body);
  }
  .guide__label {
    font-size: 13px;
    font-weight: var(--fw-semi);
    color: var(--text-strong);
    margin-top: 4px;
  }
  .guide__submit {
    margin-top: 8px;
    justify-content: center;
  }
  .guide__error {
    font-size: 13px;
    color: var(--lpt-red, #d93025);
    min-height: 18px;
    margin: 0;
  }
  .guide__success {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 16px;
    font-size: 14px;
    color: var(--text-strong);
    margin-top: 4px;
  }
  .guide__success-icon { font-size: 20px; flex-shrink: 0; }

  @media (max-width: 980px) {
    .guide__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

<script>
  const form    = document.getElementById("guide-form") as HTMLFormElement;
  const input   = document.getElementById("guide-email") as HTMLInputElement;
  const btn     = document.getElementById("guide-btn") as HTMLButtonElement;
  const errEl   = document.getElementById("guide-error")!;
  const successEl = document.getElementById("guide-success")!;
  const labelEl = btn.querySelector(".guide-btn-label") as HTMLElement;
  const loadEl  = btn.querySelector(".guide-btn-loading") as HTMLElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errEl.textContent = "";

    const email = input.value.trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = "Saisis une adresse email valide.";
      input.focus();
      return;
    }

    // State: loading
    btn.disabled = true;
    labelEl.style.display = "none";
    loadEl.style.display  = "";

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, type: "guide" }),
      });
      const data = await res.json();

      if (data.ok) {
        form.style.display = "none";
        successEl.style.display = "flex";
      } else {
        errEl.textContent = data.error ?? "Une erreur est survenue, réessaie.";
        btn.disabled = false;
        labelEl.style.display = "";
        loadEl.style.display  = "none";
      }
    } catch {
      errEl.textContent = "Erreur réseau, vérifie ta connexion et réessaie.";
      btn.disabled = false;
      labelEl.style.display = "";
      loadEl.style.display  = "none";
    }
  });
</script>
