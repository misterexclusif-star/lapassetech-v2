---
/**
 * Page fiche métier — MetierLayout (v4.5) + contenu Markdown rendu.
 */
import { getCollection, render } from "astro:content";
import MetierLayout from "../../layouts/MetierLayout.astro";

export async function getStaticPaths() {
  const metiers = await getCollection("metiers", ({ data }) => !data.draft);
  return metiers.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<MetierLayout
  id={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  family={entry.data.family}
  icon={entry.data.icon}
  salary={entry.data.salary}
  salarySenior={entry.data.salarySenior}
  reconversionTime={entry.data.reconversionTime}
  accessibility={entry.data.accessibility}
  tags={entry.data.tags}
  formations={entry.data.formations}
>
  <Content />
</MetierLayout>
