<script>
  // Ouverture / fermeture de la modal PDF.
  const modal = document.getElementById("pdf-modal")!;
  const openBtn = document.getElementById("open-pdf-modal")!;
  const input = document.getElementById("guide-email") as HTMLInputElement;

  function openModal() {
    modal.hidden = false;
    document.body.style.overflow = "hidden";
    input.focus();
  }
  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = "";
  }
  openBtn.addEventListener("click", openModal);
  modal.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", closeModal));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.hidden) closeModal();
  });

  // Soumission — même circuit que le formulaire guide de la homepage :
  // POST /api/subscribe { type: "guide" } → groupe MailerLite « guide ».
  const form = document.getElementById("guide-form") as HTMLFormElement;
  const btn = document.getElementById("guide-btn") as HTMLButtonElement;
  const errEl = document.getElementById("guide-error")!;
  const successEl = document.getElementById("guide-success")!;
  const labelEl = btn.querySelector(".guide-btn-label") as HTMLElement;
  const loadEl = btn.querySelector(".guide-btn-loading") as HTMLElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errEl.textContent = "";

    const email = input.value.trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = "Saisis une adresse email valide.";
      input.focus();
      return;
    }

    btn.disabled = true;
    labelEl.style.display = "none";
    loadEl.style.display = "";

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, type: "guide" }),
      });
      const data = await res.json();

      if (data.ok) {
        form.querySelector(".field")!.setAttribute("style", "display:none");
        successEl.style.display = "block";
      } else {
        errEl.textContent = data.error ?? "Une erreur est survenue, réessaie.";
        btn.disabled = false;
        labelEl.style.display = "";
        loadEl.style.display = "none";
      }
    } catch {
      errEl.textContent = "Erreur réseau, vérifie ta connexion et réessaie.";
      btn.disabled = false;
      labelEl.style.display = "";
      loadEl.style.display = "none";
    }
  });
</script>
