  .rtime {
    font-family: var(--mono);
    font-size: 0.66rem;
    background: var(--jaune);
    border: 1.5px solid var(--noir);
    border-radius: var(--radius-pill);
    padding: 4px 11px;
  }
  .rs-layout {
    max-width: 820px;
    padding: 10px 0 60px;
  }
  .rel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid var(--noir);
