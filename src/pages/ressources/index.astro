---
/**
 * Listing des ressources (v4.5). Cartes à bordure gauche colorée par thème,
 * pastille de niveau (point jaune débutant / caramel intermédiaire), durée jaune.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const ressources = await getCollection("ressources", ({ data }) => !data.draft);

const levelLabels: Record<string, string> = {
  deb: "débutant",
  int: "intermédiaire",
  avance: "avancé",
};
const themeCat = (theme: string) => {
  const t = theme.toLowerCase();
  if (t.includes("financement")) return "cat-fin";
  if (t.includes("ia")) return "cat-reco";
  if (t.includes("no-code")) return "cat-perso";
  return "cat-met";
};
const borderClass = (theme: string) => {
  const t = theme.toLowerCase();
  if (t.includes("financement")) return "bl-jaune";
  if (t.includes("ia")) return "bl-caramel";
  if (t.includes("no-code")) return "bl-terracotta";
  return "bl-noir";
};

const filters: { label: string; value: string }[] = [
  { label: "toutes", value: "*" },
  { label: "outils IA", value: "Outils IA" },
  { label: "no-code", value: "No-code" },
  { label: "financement", value: "Financement" },
  { label: "compétences", value: "Compétences" },
];
---

<BaseLayout
  title="Ressources — Passer à l'action · LaPasseTech"
  description="Des pas-à-pas concrets, classés par thème et par niveau. Tu peux les faire le soir-même, sur ton téléphone."
>
  <div class="wrap">
    <nav class="crumb" aria-label="Fil d'ariane"><a href="/">accueil</a> → ressources</nav>
    <div class="page-hero">
      <span class="eyebrow rv">l'action</span>
      <h1 class="rv d1">Passer à <em class="s">l'action.</em></h1>
      <p class="sub rv d2">
        Des pas-à-pas concrets, classés par thème et par niveau. Tu peux les faire le soir-même,
        sur ton téléphone.
      </p>
      <span class="count rv d2" id="res-count">{ressources.length + 1} ressources</span>
    </div>

    <div class="toolbar rv">
      <input
        id="res-search"
        class="search"
        placeholder="Rechercher une ressource…"
        type="search"
        autocomplete="off"
        aria-label="Rechercher une ressource"
      />
      <div class="pills" role="group" aria-label="Filtrer par thème">
        {
          filters.map((f, i) => (
            <button class="pill" data-filter={f.value} aria-pressed={i === 0 ? "true" : "false"}>
              {f.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="agrid" id="res-grid">
      <!-- Page statique hors collection (gabarit sur mesure) — carte ajoutée à la main. -->
      <a
        href="/ressources/analyse-formation-cpf"
        class="acard rescard bl-jaune"
        data-tag="Financement"
        data-search="analyse n'importe quelle formation cpf avec l'ia 5 prompts pour passer une formation cpf au détecteur de mensonges — avant d'y mettre tes droits et tes 150 € de ta poche."
      >
        <div class="rtags">
          <span class="lvl">débutant</span>
          <span class="acat cat-fin">financement</span>
        </div>
        <h2>Analyse n'importe quelle formation CPF avec l'IA</h2>
        <p>
          5 prompts pour passer une formation CPF au détecteur de mensonges — avant d'y mettre tes
          droits et tes 150&nbsp;€ de ta poche.
        </p>
        <span class="res-time">10 min</span>
        <span class="alire">Ouvrir la ressource</span>
      </a>
      {
        ressources.map((r) => (
          <a
            href={`/ressources/${r.id}`}
            class={`acard rescard ${borderClass(r.data.theme)}`}
            data-tag={r.data.theme}
            data-search={`${r.data.title} ${r.data.description}`.toLowerCase()}
          >
            <div class="rtags">
              <span class={`lvl ${r.data.level === "deb" ? "" : "inter"}`}>
                {levelLabels[r.data.level] ?? r.data.level}
              </span>
              <span class={`acat ${themeCat(r.data.theme)}`}>{r.data.theme.toLowerCase()}</span>
            </div>
            <h2>{r.data.title}</h2>
            <p>{r.data.description}</p>
            {r.data.duration && <span class="res-time">{r.data.duration}</span>}
            <span class="alire">Ouvrir la ressource</span>
          </a>
        ))
      }
    </div>
    <p class="no-result" id="res-empty">
      // aucune ressource ne correspond — essaie un autre mot-clé ou un autre thème
    </p>
  </div>

  <section class="page-cta">
    <div class="wrap">
      <h2>
        Tu ne sais pas par quelle ressource commencer ? <em class="s">PassBot, lui, sait.</em>
      </h2>
      <a href="/bilan" class="btn btn-jaune">Faire mon bilan gratuit →</a>
      <span class="mono">// 5 minutes · sans email obligatoire</span>
    </div>
  </section>
</BaseLayout>

<style>
  .rescard {
    border-left-width: 8px;
    border-left-style: solid;
  }
  .rescard.bl-jaune { border-left-color: var(--jaune); }
  .rescard.bl-caramel { border-left-color: var(--caramel); }
  .rescard.bl-terracotta { border-left-color: var(--terracotta); }
  .rescard.bl-noir { border-left-color: var(--noir); }
  .rtags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .lvl {
    font-family: var(--mono);
    font-size: 0.64rem;
    font-weight: var(--fw-semi);
    padding: 4px 11px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--noir);
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    background: #fff;
  }
  .lvl::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--jaune);
    border: 1px solid var(--noir);
  }
  .lvl.inter::before {
    background: var(--caramel);
  }
  .res-time {
    font-family: var(--mono);
    font-size: 0.66rem;
    background: var(--jaune);
    border: 1.5px solid var(--noir);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    align-self: flex-start;
  }
</style>

<script>
  const search = document.getElementById("res-search") as HTMLInputElement;
  const countEl = document.getElementById("res-count")!;
  const emptyEl = document.getElementById("res-empty")!;
  const pills = document.querySelectorAll<HTMLButtonElement>(".pills .pill");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("#res-grid .acard"));

  let activeFilter = "*";
  let q = "";

  function apply() {
    let visible = 0;
    cards.forEach((card) => {
      const matchFilter = activeFilter === "*" || card.dataset.tag === activeFilter;
      const matchSearch = q === "" || (card.dataset.search ?? "").includes(q);
      const show = matchFilter && matchSearch;
      card.style.display = show ? "" : "none";
      if (show) visible++;
    });
    emptyEl.style.display = visible === 0 ? "block" : "none";
    countEl.textContent = `${visible} ressource${visible > 1 ? "s" : ""}`;
  }

  pills.forEach((btn) => {
    btn.addEventListener("click", () => {
      pills.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");
      activeFilter = btn.dataset.filter ?? "*";
      apply();
    });
  });
  search.addEventListener("input", () => {
    q = search.value.trim().toLowerCase();
    apply();
  });
</script>
