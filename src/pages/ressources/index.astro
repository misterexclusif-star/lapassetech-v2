---
/**
 * Listing des ressources. Hero + filtres actifs + recherche client-side.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const ressources = await getCollection("ressources", ({ data }) => !data.draft);

const levelLabels: Record<string, string> = { deb: "Débutant", int: "Intermédiaire", avance: "Avancé" };

const filters: { label: string; value: string }[] = [
  { label: "Toutes",       value: "*" },
  { label: "Outils IA",    value: "Outils IA" },
  { label: "No-code",      value: "No-code" },
  { label: "Financement",  value: "Financement" },
  { label: "Compétences",  value: "Compétences" },
];
---

<BaseLayout title="Ressources — Passer à l'action · LaPasseTech" description="Des ressources pratiques à appliquer dès ce soir : outils IA, no-code, financement.">
  <section class="lpt-listing-hero">
    <nav class="lpt-breadcrumb"><a href="/">Accueil</a> → <span>Ressources</span></nav>
    <h1 style="margin-top:14px;">Passer à <em class="lpt-serif-italic" style="color:var(--accent)">l'action.</em></h1>
    <p>Des pas-à-pas concrets, classés par thème et par niveau. Tu peux les faire le soir-même, sur ton téléphone.</p>
    <div class="lpt-listing-hero__count" id="res-count">{ressources.length} ressource{ressources.length > 1 ? "s" : ""}</div>
  </section>

  <div class="lpt-filterbar">
    <input id="res-search" class="lpt-input lpt-search" placeholder="Rechercher une ressource…" type="search" autocomplete="off" />
    <div class="lpt-filters">
      {filters.map((f, i) => (
        <button
          class="lpt-filter"
          data-filter={f.value}
          data-active={i === 0 ? "" : undefined}
        >{f.label}</button>
      ))}
    </div>
  </div>

  <div class="lpt-grid-section">
    <div class="lpt-card-grid" id="res-grid">
      {
        ressources.map((r) => (
          <article
            class="lpt-article-card"
            data-theme={r.data.theme}
            data-title={r.data.title.toLowerCase()}
            data-desc={r.data.description.toLowerCase()}
          >
            <div style="display:flex; gap:8px; align-items:center;">
              <span class={`lpt-level lpt-level--${r.data.level === "avance" ? "int" : r.data.level}`}>
                <span class="lpt-level__dot"></span>{levelLabels[r.data.level]}
              </span>
              <span class="lpt-tag">{r.data.theme}</span>
            </div>
            <a class="lpt-article-card__title" href={`/ressources/${r.id}`}>{r.data.title}</a>
            <p style="font-size:13.5px; color:var(--text-body); margin:0;">{r.data.description}</p>
            <div class="lpt-article-card__foot">
              {r.data.duration && <span>{r.data.duration}</span>}
            </div>
            <a class="lpt-article-card__link" href={`/ressources/${r.id}`}>Ouvrir la ressource →</a>
          </article>
        ))
      }
    </div>
    <p id="res-empty" style="display:none; padding:40px 0; color:var(--text-muted); text-align:center;">Aucune ressource ne correspond à ta recherche.</p>
  </div>
</BaseLayout>

<script>
  const grid    = document.getElementById("res-grid")!;
  const search  = document.getElementById("res-search") as HTMLInputElement;
  const countEl = document.getElementById("res-count")!;
  const emptyEl = document.getElementById("res-empty")!;
  const btns    = document.querySelectorAll<HTMLButtonElement>(".lpt-filters .lpt-filter");
  const cards   = Array.from(grid.querySelectorAll<HTMLElement>("article.lpt-article-card"));

  let activeFilter = "*";
  let searchQuery  = "";

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const theme = card.dataset.theme ?? "";
      const title = card.dataset.title ?? "";
      const desc  = card.dataset.desc  ?? "";

      const matchFilter = activeFilter === "*" || theme === activeFilter;
      const matchSearch = searchQuery === "" ||
        title.includes(searchQuery) ||
        desc.includes(searchQuery) ||
        theme.toLowerCase().includes(searchQuery);

      const show = matchFilter && matchSearch;
      card.style.display = show ? "" : "none";
      if (show) visible++;
    });

    emptyEl.style.display = visible === 0 ? "" : "none";
    countEl.textContent = `${visible} ressource${visible > 1 ? "s" : ""}`;
  }

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      btns.forEach((b) => b.removeAttribute("data-active"));
      btn.setAttribute("data-active", "");
      activeFilter = btn.dataset.filter ?? "*";
      applyFilters();
    });
  });

  search.addEventListener("input", () => {
    searchQuery = search.value.trim().toLowerCase();
    applyFilters();
  });
</script>
