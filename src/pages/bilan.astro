---
/**
 * Bilan — stub iframe PassBot UNIQUEMENT (aucune logique Astro).
 * L'iframe pointe vers le Typebot PassBot.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const PASSBOT_URL = "https://typebot.co/pass-bot-la-passe-tech-05k4p4j";
---

<BaseLayout title="Mon bilan — PassBot · LaPasseTech" description="Fais ton bilan gratuit avec PassBot : 8 questions, 10 minutes, un plan d'action personnalisé.">
  <section class="bilan-page">
    <iframe src={PASSBOT_URL} title="PassBot — ton bilan gratuit" loading="lazy"></iframe>
  </section>
</BaseLayout>

<style>
  .bilan-page {
    /* L'iframe occupe la hauteur disponible sous la chrome (ticker 36 + nav 64). */
    height: calc(100vh - 100px);
    min-height: 560px;
  }
  .bilan-page iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
